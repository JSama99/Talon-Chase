# Generate each value with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
CHASE_API_KEY=
CHASE_SECRET=
CHASE_BASE_URL=http://localhost:8000
# Run the tick inside the service every N seconds (0 = off; call POST /v1/tick yourself).
CHASE_TICK_SECONDS=0

# Email through Resend (docs/EMAIL.md). Leave the key empty to keep the in-memory stand-in.
RESEND_API_KEY=
# The webhook's signing secret from Resend (whsec_...).
RESEND_WEBHOOK_SECRET=
# Domains verified in Resend, comma-separated. Mail from them is sent as written.
RESEND_VERIFIED_DOMAINS=
# Brokers without a verified domain send through this address (on a verified domain)...
RESEND_SHARED_FROM=
# ...and replies to it come back to this domain (a *.resend.app address, or your own MX).
RESEND_INBOUND_DOMAIN=
CHASE_LOGIN_FROM=Talon Chase <signin@yourdomain.example>
